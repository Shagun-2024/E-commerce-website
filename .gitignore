# ============================================================
#  Root .gitignore — Final Year Project
#  Covers: backend (Node/Express), frontend & admin (React/Vite)
# ============================================================

# ---------------------------
# Environment & Secrets
# ---------------------------
.env
.env.*
!.env.example

# ---------------------------
# Dependencies
# ---------------------------
node_modules/
**/node_modules/

# ---------------------------
# Build Output
# ---------------------------
dist/
dist-ssr/
build/
**/dist/
**/build/

# ---------------------------
# Vite / React specific
# ---------------------------
*.local
.vite/
vite.config.js.timestamp-*

# ---------------------------
# Logs
# ---------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------
# Runtime / OS files
# ---------------------------
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------
# Editor directories
# ---------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace

# ---------------------------
# Package manager lock files
# (keep package-lock.json; ignore others if using npm only)
# ---------------------------
yarn.lock
pnpm-lock.yaml

# ---------------------------
# Uploads / temporary files
# ---------------------------
uploads/
tmp/
temp/

# ---------------------------
# Coverage & Testing
# ---------------------------
coverage/
.nyc_output/
