# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://my-frontend.vercel.app,https://my-admin.vercel.app
FRONTEND_URL=http://localhost:5173,http://localhost:5174

JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/e-commerce?retryWrites=true&w=majority

CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key
CLOUDINARY_NAME=your_cloudinary_cloud_name

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
